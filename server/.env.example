# Trinetra Digital CRM & WhatsApp Automation Backend Configuration
# Copy this file to .env and fill in your actual values

# ── NETWORK SETTINGS ──────────────────────────────────────────────────────────
# The active port for the Express REST web server
PORT=5000

# ── DATABASE & SESSION PERSISTENCE ───────────────────────────────────────────
# Path to the SQLite WAL database file (created automatically if missing)
DATABASE_PATH=./data/trinetra.db

# Path to the WhatsApp Baileys credentials folder (pairs and stays persistent)
WHATSAPP_SESSION_PATH=./data/wa-session

# ── SECURITY CREDENTIALS ─────────────────────────────────────────────────────
# A secure JWT signature token used to sign administrator dashboard sessions
# Generate one at: https://randomkeygen.com/ (use Fort Knox Passwords)
JWT_SECRET=your_super_secret_long_random_hash_key_here

# ── AI ENGINE ────────────────────────────────────────────────────────────────
# OpenRouter API key for the AI conversation engine (Gemini Flash → DeepSeek cascade)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Legacy: Gemini direct key (fallback, not required if OPENROUTER_API_KEY is set)
# GEMINI_API_KEY=YOUR_SECURE_GEMINI_API_KEY_HERE

# ── ADMIN NOTIFICATIONS ───────────────────────────────────────────────────────
# WhatsApp number to receive admin alerts (handoffs, FIRE leads, appointments)
# Format: international number without + (e.g., 919334757759 for +91 93347 57759)
ADMIN_NOTIFY_PHONE=+919334757759

# ── APPOINTMENT BOOKING ───────────────────────────────────────────────────────
# Calendly or booking page URL shared with leads when they request consultation
CALENDLY_URL=https://calendly.com/trinetra-demo

# ── OPTIONAL FRONTEND MAPPINGS ────────────────────────────────────────────────
# Allowed CORS origins (e.g. for custom Vercel deployments or custom domains)
FRONTEND_URL=https://trinetradigitalsolution.com
NODE_ENV=production
